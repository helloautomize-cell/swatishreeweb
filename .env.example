# Copy to .env.local and fill in. Never commit the filled-in file.

# Absolute site URL used for canonicals, JSON-LD @ids and llms.txt. Falls
# back to http://localhost:3000 in development and must be set on the
# production deployment before build.
SITE_URL=

# Launch lock (master prompt Part 11). Leave unset (or anything but "1")
# until the client approves indexing: every host returns noindex and
# robots.txt disallows everything while this is not "1".
SITE_INDEXABLE=

# Appointment form email (Part 5.3, Part 12). All three are required for
# the server action to send; without them, submissions fail closed and the
# visitor sees the Call/WhatsApp fallback instead of a false success.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APPOINTMENT_NOTIFY_EMAIL=

# Cloudflare Turnstile (Part 12 "Forms"). Optional: the form has no bot
# check at all until both of these are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# GA4, loaded only after cookie consent (Part 12 "Analytics"). Optional:
# no gtag.js request happens at all until this is set.
NEXT_PUBLIC_GA_ID=
